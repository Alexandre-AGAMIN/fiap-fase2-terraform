# Local .terraform directories
**/.terraform/*

# Terraform lock file
.terraform.lock.hcl
**/.terraform.lock.hcl

# State files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variables
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
